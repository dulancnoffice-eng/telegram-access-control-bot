{
  "name": "telegram-cloudflare-access-bot",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/bot.js && node --check src/db.js && node --check src/telegram.js && node --check src/util.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply telegram-access-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-access-control --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
